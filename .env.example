# Required
ANTHROPIC_API_KEY=sk-ant-...

# Emily agent
MODEL=claude-haiku-4-5-20251001
PORT=8080
FATBABY_ROOT=.
GIT_COMMIT=true
RATE_LIMIT_RPM=20
MAX_TOOL_ITERS=10

# IDUNA IAM integration (optional — enables JWT auth on all protected endpoints)
# IDUNA_JWKS_URL=https://iam.farthq.internal/api/v1/jwks
# IDUNA_BASE_URL=https://iam.farthq.internal
# IDUNA_AGENT_NAME=EMILY
# IDUNA_AGENT_SECRET=...

# Emily Prime integration (optional — auto-detected if ../EMILY/signals/tasks exists)
# EMILY_INTEGRATION_DIR=../EMILY/signals
# EMILY_PRIME_TASKS_DIR=../EMILY/signals/tasks

# SEC EDGAR feed
# EDGAR_USER_AGENT=MyOrg contact@example.com

# Observation watcher
# OBSERVATION_CMD=claude
# OBSERVATION_CMD_ARGS=--dangerously-skip-permissions
# OBSERVATION_GATE=nontrivial
