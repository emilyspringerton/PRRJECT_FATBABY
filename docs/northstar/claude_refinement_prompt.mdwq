## F. Code Patterns

\`\`\`go
// Skeleton for new signal scorer
func ScoreFrictionDirector(approvalPct float64, approvalTrend []float64, boardSize int) float64 {
    // Pseudocode
    base := 1.0 - approvalPct
    trend := slope(approvalTrend) * -1 // declining trend worsens score
    size_factor := 1.0 + (1.0 / float64(boardSize)) // smaller board = more significant
    
    return base * (1 + trend) * size_factor
}
\`\`\`

