# Production environment variables for FatBaby pipeline.
# Copy to ops/env.production and fill in values.
# DO NOT COMMIT actual secrets — this file is in .gitignore.

# Anthropic API key (Emily agent + processor).
ANTHROPIC_API_KEY=

# MySQL read model (signalapi + projector).
MYSQL_URL=fatbaby:CHANGE_ME@tcp(127.0.0.1:3306)/fatbaby?parseTime=true
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_PASSWORD=CHANGE_ME

# MongoDB entity graph (entity-graph + signalapi).
MONGODB_URL=mongodb://fatbaby:CHANGE_ME@127.0.0.1:27017/fatbaby?authSource=admin
MONGODB_DB=fatbaby
MONGO_USER=fatbaby
MONGO_PASSWORD=CHANGE_ME

# Emily Prime base URL (newssite Ask Emily proxy).
EMILY_BASE_URL=http://localhost:8086

# signalapi URL (newssite context enrichment).
SIGNALAPI_URL=http://localhost:9091

# IDUNA IAM.
IDUNA_BASE_URL=http://localhost:8080
IDUNA_AGENT_NAME=FATBABY_EMILY
IDUNA_AGENT_SECRET=
