# FatBaby guidance-watcher — user-level systemd unit (no sudo required)
#
# Deploy:
#   mkdir -p ~/.config/systemd/user
#   cp ops/systemd/fatbaby-guidance-watcher.service ~/.config/systemd/user/
#   go build -o /home/fatbaby/PRRJECT_FATBABY/bin/guidance-watcher ./cmd/guidance-watcher
#   systemctl --user daemon-reload
#   systemctl --user enable --now fatbaby-guidance-watcher.service
#
# Added 2026-07-19 -- was never supervised at all; see
# fatbaby-dividend-watcher.service's header for the audit context. First
# live one-shot run found real, previously-unpublished guidance (7 items),
# confirming this had real backlog to catch up on.

[Unit]
Description=FatBaby guidance-watcher (forward guidance raise/lower/maintain classifier)
After=network-online.target fatbaby-prwatch-body.service

[Service]
Type=simple
WorkingDirectory=/home/fatbaby/PRRJECT_FATBABY
ExecStart=/home/fatbaby/PRRJECT_FATBABY/bin/guidance-watcher \
    -discovery-store /home/fatbaby/PRRJECT_FATBABY/var/prwatch \
    -body-store /home/fatbaby/PRRJECT_FATBABY/var/prwatch-body \
    -out-dir /home/fatbaby/PRRJECT_FATBABY/var/guidance \
    -cursor /home/fatbaby/PRRJECT_FATBABY/var/guidance-watcher/.cursor \
    -poll-interval 30s
OOMScoreAdjust=-300
Restart=on-failure
RestartSec=10s
StandardOutput=append:/home/fatbaby/PRRJECT_FATBABY/var/logs/guidance-watcher.log
StandardError=append:/home/fatbaby/PRRJECT_FATBABY/var/logs/guidance-watcher.log
MemoryMax=128M
TasksMax=32

[Install]
WantedBy=default.target
