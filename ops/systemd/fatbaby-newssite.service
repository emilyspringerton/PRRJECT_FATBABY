[Unit]
Description=FatBaby Newssite (:8082)
After=network.target
Wants=fatbaby-processor.service

[Service]
Type=simple
User=fatbaby
Group=fatbaby
WorkingDirectory=/home/fatbaby/PRRJECT_FATBABY
EnvironmentFile=-/home/fatbaby/PRRJECT_FATBABY/ops/env.production
ExecStart=/home/fatbaby/PRRJECT_FATBABY/bin/newssite \
    -store /home/fatbaby/PRRJECT_FATBABY/var/secwatch \
    -addr :8082 \
    -commentary-dir /home/fatbaby/PRRJECT_FATBABY/var/commentary \
    -graph-dir /home/fatbaby/PRRJECT_FATBABY/var/entity-graph \
    -doc-index-dir /home/fatbaby/PRRJECT_FATBABY/var/docindex \
    -eps-dir /home/fatbaby/PRRJECT_FATBABY/var/eps
Restart=always
RestartSec=5s
TimeoutStopSec=10s
StandardOutput=append:/home/fatbaby/PRRJECT_FATBABY/var/logs/newssite.log
StandardError=append:/home/fatbaby/PRRJECT_FATBABY/var/logs/newssite.log
# Memory guard: restart if newssite exceeds 512MB (file store can grow).
MemoryMax=512M
# File descriptor limit: nginx can hold many connections open.
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
