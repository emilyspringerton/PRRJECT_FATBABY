# FatBaby nt-watcher — user-level systemd unit (no sudo required)
#
# Deploy:
#   mkdir -p ~/.config/systemd/user
#   cp ops/systemd/fatbaby-nt-watcher.service ~/.config/systemd/user/
#   go build -o /home/fatbaby/PRRJECT_FATBABY/bin/nt-watcher ./cmd/nt-watcher
#   systemctl --user daemon-reload
#   systemctl --user enable --now fatbaby-nt-watcher.service
#
# Added 2026-07-19 -- was never supervised at all; see
# fatbaby-dividend-watcher.service's header for the audit context.
# 12h poll interval (matches the flag default) since this polls EDGAR
# directly across the whole watchlist, not the local event store.

[Unit]
Description=FatBaby nt-watcher (NT 10-K/10-Q late-filing notifications)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/fatbaby/PRRJECT_FATBABY
ExecStart=/home/fatbaby/PRRJECT_FATBABY/bin/nt-watcher \
    -watchlist /home/fatbaby/PRRJECT_FATBABY/config/watchlist.json \
    -graph-dir /home/fatbaby/PRRJECT_FATBABY/var/entity-graph \
    -out-dir /home/fatbaby/PRRJECT_FATBABY/var/nt-filings \
    -poll-interval 12h
OOMScoreAdjust=-300
Restart=on-failure
RestartSec=30s
StandardOutput=append:/home/fatbaby/PRRJECT_FATBABY/var/logs/nt-watcher.log
StandardError=append:/home/fatbaby/PRRJECT_FATBABY/var/logs/nt-watcher.log
MemoryMax=128M
TasksMax=32

[Install]
WantedBy=default.target
