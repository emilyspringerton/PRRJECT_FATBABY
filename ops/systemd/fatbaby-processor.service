[Unit]
Description=FatBaby Processor (signal extraction)
After=network.target

[Service]
Type=simple
User=fatbaby
Group=fatbaby
WorkingDirectory=/home/fatbaby/PRRJECT_FATBABY
EnvironmentFile=-/home/fatbaby/PRRJECT_FATBABY/ops/env.production
ExecStart=/home/fatbaby/PRRJECT_FATBABY/bin/processor \
    -store /home/fatbaby/PRRJECT_FATBABY/var/secwatch \
    -workers 4 \
    -poll-interval 15s
Restart=always
RestartSec=10s
TimeoutStopSec=30s
StandardOutput=append:/home/fatbaby/PRRJECT_FATBABY/var/logs/processor.log
StandardError=append:/home/fatbaby/PRRJECT_FATBABY/var/logs/processor.log
MemoryMax=256M

[Install]
WantedBy=multi-user.target
