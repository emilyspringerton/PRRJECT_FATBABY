# FatBaby processor — user-level systemd unit (no sudo required)
#
# Deploy:
#   mkdir -p ~/.config/systemd/user
#   cp ops/systemd/fatbaby-processor.service ~/.config/systemd/user/
#   go build -o /home/fatbaby/PRRJECT_FATBABY/bin/processor ./cmd/processor
#   systemctl --user daemon-reload
#   systemctl --user enable --now fatbaby-processor.service
#
# Added 2026-07-17 (BACKLOG SECTION 152, S152-03) after secwatch and
# eps-reconciler were both silently OOM-killed and stayed down for hours
# with zero auto-recovery — replaces the previous manually-launched
# `go run ./cmd/processor` process, which had no restart-on-crash and did
# not survive a reboot.
#
[Unit]
Description=FatBaby processor (filing/PR -> structured signal extraction)
After=network-online.target fatbaby-secwatch.service

[Service]
Type=simple
WorkingDirectory=/home/fatbaby/PRRJECT_FATBABY
EnvironmentFile=-/home/fatbaby/.config/fatbaby/env
ExecStart=/home/fatbaby/PRRJECT_FATBABY/bin/processor \
    -store /home/fatbaby/PRRJECT_FATBABY/var/secwatch \
    -workers 4 \
    -poll-interval 15s
OOMScoreAdjust=-300
Restart=on-failure
RestartSec=10s
StandardOutput=append:/home/fatbaby/PRRJECT_FATBABY/var/logs/processor.log
StandardError=append:/home/fatbaby/PRRJECT_FATBABY/var/logs/processor.log
MemoryMax=256M
TasksMax=32

[Install]
WantedBy=default.target
