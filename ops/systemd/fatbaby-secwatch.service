[Unit]
Description=FatBaby secwatch (SEC EDGAR poller)
After=network.target

[Service]
Type=simple
User=fatbaby
Group=fatbaby
WorkingDirectory=/home/fatbaby/PRRJECT_FATBABY
EnvironmentFile=-/home/fatbaby/PRRJECT_FATBABY/ops/env.production
ExecStart=/home/fatbaby/PRRJECT_FATBABY/bin/secwatch \
    -watchlist /home/fatbaby/PRRJECT_FATBABY/config/watchlist.json \
    -store /home/fatbaby/PRRJECT_FATBABY/var/secwatch \
    -poll-interval 5m \
    -rate-rps 2
Restart=always
RestartSec=30s
StandardOutput=append:/home/fatbaby/PRRJECT_FATBABY/var/logs/secwatch.log
StandardError=append:/home/fatbaby/PRRJECT_FATBABY/var/logs/secwatch.log
MemoryMax=128M

[Install]
WantedBy=multi-user.target
