# FatBaby secwatch — user-level systemd unit (no sudo required)
#
# Deploy:
#   mkdir -p ~/.config/systemd/user
#   cp ops/systemd/fatbaby-secwatch.service ~/.config/systemd/user/
#   go build -o /home/fatbaby/PRRJECT_FATBABY/bin/secwatch ./cmd/secwatch
#   systemctl --user daemon-reload
#   systemctl --user enable --now fatbaby-secwatch.service
#
# Added 2026-07-17 (BACKLOG SECTION 152, S152-03) after secwatch and
# eps-reconciler were both silently OOM-killed and stayed down for hours
# with zero auto-recovery — replaces the previous manually-launched
# `go run ./cmd/secwatch` process, which had no restart-on-crash and did
# not survive a reboot.
#
[Unit]
Description=FatBaby secwatch (SEC EDGAR filing poller)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/fatbaby/PRRJECT_FATBABY
ExecStart=/home/fatbaby/PRRJECT_FATBABY/bin/secwatch \
    -watchlist /home/fatbaby/PRRJECT_FATBABY/config/watchlist.json \
    -store /home/fatbaby/PRRJECT_FATBABY/var/secwatch \
    -poll-interval 5m \
    -rate-rps 2
OOMScoreAdjust=-300
Restart=on-failure
RestartSec=15s
StandardOutput=append:/home/fatbaby/PRRJECT_FATBABY/var/logs/secwatch.log
StandardError=append:/home/fatbaby/PRRJECT_FATBABY/var/logs/secwatch.log
MemoryMax=384M
TasksMax=32

[Install]
WantedBy=default.target
